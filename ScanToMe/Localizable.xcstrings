    "%@ Still using the previous settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se siguen usando los ajustes anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Les r\u00e9glages pr\u00e9c\u00e9dents restent utilis\u00e9s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u4ecd\u5728\u4f7f\u7528\u4e4b\u524d\u7684\u8bbe\u7f6e\u3002"
          }
        }
      }
    },
    "%@ can't be opened right now (%@). Scans are saved in the app folder until it is available again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir %1$@ en este momento (%2$@). Los escaneos se guardan en la carpeta de la app hasta que vuelva a estar disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est inaccessible pour le moment (%2$@). Les num\u00e9risations sont enregistr\u00e9es dans le dossier de l'app jusqu'\u00e0 ce qu'il soit de nouveau disponible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6682\u65f6\u65e0\u6cd5\u6253\u5f00 %1$@\uff08%2$@\uff09\u3002\u5728\u5176\u6062\u590d\u53ef\u7528\u4e4b\u524d\uff0c\u626b\u63cf\u4ef6\u5c06\u4fdd\u5b58\u5728 App \u6587\u4ef6\u5939\u4e2d\u3002"
          }
        }
      }
    },
    "%@ will be deleted from its folder. This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se eliminar\u00e1 de su carpeta. Esta acci\u00f3n no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprim\u00e9 de son dossier. Cette action est irr\u00e9versible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u4ece\u6240\u5728\u6587\u4ef6\u5939\u4e2d\u5220\u9664 %@\u3002\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002"
          }
        }
      }
    },
    "%@:%lld is already in your list as \"%@\".": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld ya est\u00e1 en tu lista como \u00ab%3$@\u00bb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld figure d\u00e9j\u00e0 dans votre liste sous le nom \u00ab %3$@ \u00bb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld \u5df2\u5728\u5217\u8868\u4e2d\uff0c\u540d\u79f0\u4e3a\u201c%3$@\u201d\u3002"
          }
        }
      }
    },
