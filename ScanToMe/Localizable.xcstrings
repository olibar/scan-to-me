    "Scan to Me appears on the printer only while the app is open and listening. iOS suspends network access in the background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me solo aparece en la impresora mientras la app est\u00e1 abierta y a la escucha. iOS suspende el acceso a la red en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me n'appara\u00eet sur l'imprimante que lorsque l'app est ouverte et \u00e0 l'\u00e9coute. iOS suspend l'acc\u00e8s r\u00e9seau en arri\u00e8re-plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5f53 App \u5904\u4e8e\u6253\u5f00\u548c\u76d1\u542c\u72b6\u6001\u65f6\uff0cScan to Me \u624d\u4f1a\u51fa\u73b0\u5728\u6253\u5370\u673a\u4e0a\u3002iOS \u4f1a\u5728\u540e\u53f0\u6682\u505c\u7f51\u7edc\u8bbf\u95ee\u3002"
          }
        }
      }
    },
    "Scan to Me only appears on the printer while this app is open and listening.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me solo aparece en la impresora mientras esta app est\u00e1 abierta y a la escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me n'appara\u00eet sur l'imprimante que lorsque cette app est ouverte et \u00e0 l'\u00e9coute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5f53\u6b64 App \u5904\u4e8e\u6253\u5f00\u548c\u76d1\u542c\u72b6\u6001\u65f6\uff0cScan to Me \u624d\u4f1a\u51fa\u73b0\u5728\u6253\u5370\u673a\u4e0a\u3002"
          }
        }
      }
    },
    "Scan to Me stops listening for it. You can add it again later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me dejar\u00e1 de escucharla. Puedes volver a a\u00f1adirla m\u00e1s tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me cessera de l'\u00e9couter. Vous pourrez l'ajouter de nouveau plus tard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me \u5c06\u505c\u6b62\u76d1\u542c\u6b64\u6253\u5370\u673a\u3002\u4f60\u53ef\u4ee5\u7a0d\u540e\u518d\u6b21\u6dfb\u52a0\u3002"
          }
        }
      }
    },
    "Scanning": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
