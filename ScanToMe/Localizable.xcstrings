            "value": "\u6b63\u5728\u626b\u63cf"
          }
        }
      }
    },
    "Scanning (%lld)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneando (%lld)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Num\u00e9risation (%lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u626b\u63cf\uff08%lld\uff09"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9glages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e"
          }
        }
      }
    },
    "Shown in this app only, e.g. Home or Office.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra en esta app, p. ej., Casa u Oficina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affich\u00e9 dans cette app uniquement, par ex. Maison ou Bureau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5728\u6b64 App \u4e2d\u663e\u793a\uff0c\u4f8b\u5982\u201c\u5bb6\u201d\u6216\u201c\u529e\u516c\u5ba4\u201d\u3002"
          }
        }
      }
    },
    "Start listening": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a escuchar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer l'\u00e9coute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u59cb\u76d1\u542c"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9tat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u72b6\u6001"
          }
        }
      }
    },
    "Stop listening": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de escuchar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eater l'\u00e9coute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u76d1\u542c"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eat\u00e9e"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u505c\u6b62"
          }
        }
      }
    },
    "Swipe left on a scan: Remove hides it here and keeps the file; Delete also deletes the file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un escaneo hacia la izquierda: Quitar lo oculta aqu\u00ed y conserva el archivo; Eliminar tambi\u00e9n borra el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une num\u00e9risation vers la gauche : Retirer la masque ici et conserve le fichier ; Supprimer efface aussi le fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u626b\u63cf\u4ef6\u4e0a\u5411\u5de6\u8f7b\u626b\uff1a\u201c\u79fb\u9664\u201d\u4ec5\u5728\u6b64\u5904\u9690\u85cf\u5e76\u4fdd\u7559\u6587\u4ef6\uff1b\u201c\u5220\u9664\u201d\u8fd8\u4f1a\u5220\u9664\u6587\u4ef6\u3002"
          }
        }
      }
    },
    "The PDF idle time must be at least 10 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de inactividad del PDF debe ser de al menos 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le d\u00e9lai d'inactivit\u00e9 du PDF doit \u00eatre d'au moins 10 secondes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF \u7a7a\u95f2\u65f6\u95f4\u81f3\u5c11\u4e3a 10 \u79d2\u3002"
          }
        }
      }
    },
    "The app folder is visible in Files under On My iPhone > Scan to Me. For iCloud Drive, Dropbox, Google Drive or OneDrive, tap Choose folder, then Browse. A service missing there must be switched on in the Files app: Browse > ... > Edit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de la app est\u00e1 visible en Archivos, en En mi iPhone > Scan to Me. Para iCloud Drive, Dropbox, Google Drive u OneDrive, toca Elegir carpeta y despu\u00e9s Explorar. Si falta un servicio, act\u00edvalo en la app Archivos: Explorar > ... > Editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de l'app est visible dans Fichiers sous Sur mon iPhone > Scan to Me. Pour iCloud Drive, Dropbox, Google Drive ou OneDrive, touchez Choisir un dossier, puis Parcourir. Un service absent de la liste doit \u00eatre activ\u00e9 dans l'app Fichiers : Parcourir > ... > Modifier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App \u6587\u4ef6\u5939\u53ef\u5728\u201c\u6587\u4ef6\u201d\u4e2d\u7684\u201c\u6211\u7684 iPhone\u201d>\u201cScan to Me\u201d\u627e\u5230\u3002\u82e5\u8981\u4f7f\u7528 iCloud \u4e91\u76d8\u3001Dropbox\u3001Google Drive \u6216 OneDrive\uff0c\u8bf7\u8f7b\u70b9\u201c\u9009\u62e9\u6587\u4ef6\u5939\u201d\uff0c\u7136\u540e\u8f7b\u70b9\u201c\u6d4f\u89c8\u201d\u3002\u5982\u679c\u5176\u4e2d\u7f3a\u5c11\u67d0\u4e2a\u670d\u52a1\uff0c\u8bf7\u5728\u201c\u6587\u4ef6\u201d App \u4e2d\u5f00\u542f\uff1a\u201c\u6d4f\u89c8\u201d>\u201c...\u201d>\u201c\u7f16\u8f91\u201d\u3002"
          }
        }
      }
    },
    "The file name pattern must not be empty.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El patr\u00f3n de nombre de archivo no puede estar vac\u00edo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le de nom de fichier ne doit pas \u00eatre vide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u4ef6\u547d\u540d\u683c\u5f0f\u4e0d\u80fd\u4e3a\u7a7a\u3002"
          }
        }
      }
    },
    "The name shown on the printer must not be empty.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre mostrado en la impresora no puede estar vac\u00edo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom affich\u00e9 sur l'imprimante ne doit pas \u00eatre vide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6253\u5370\u673a\u4e0a\u663e\u793a\u7684\u540d\u79f0\u4e0d\u80fd\u4e3a\u7a7a\u3002"
          }
        }
      }
    },
    "The output folder is not available. Choose another one in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de destino no est\u00e1 disponible. Elige otra en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de destination n'est pas disponible. Choisissez-en un autre dans R\u00e9glages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b58\u50a8\u6587\u4ef6\u5939\u4e0d\u53ef\u7528\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e\u201d\u4e2d\u9009\u62e9\u5176\u4ed6\u6587\u4ef6\u5939\u3002"
          }
        }
      }
    },
    "The resolution must be between 75 and 1200 dpi (not %lld).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resoluci\u00f3n debe estar entre 75 y 1200 ppp (no %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La r\u00e9solution doit \u00eatre comprise entre 75 et 1200 ppp (et non %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5206\u8fa8\u7387\u5fc5\u987b\u4ecb\u4e8e 75 \u81f3 1200 dpi \u4e4b\u95f4\uff08\u5f53\u524d\u4e3a %lld\uff09\u3002"
          }
        }
      }
    },
    "The scanned files stay in their folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos escaneados se quedan en su carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers num\u00e9ris\u00e9s restent dans leur dossier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u626b\u63cf\u6587\u4ef6\u5c06\u4fdd\u7559\u5728\u5176\u6587\u4ef6\u5939\u4e2d\u3002"
          }
        }
      }
    },
    "The screen stays on while listening. Leave Scan to Me open, then on the printer choose Scan > Computer > \"%@\".": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla permanece encendida mientras escucha. Deja Scan to Me abierta y, en la impresora, elige Escanear > Equipo > \u00ab%@\u00bb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'\u00e9cran reste allum\u00e9 pendant l'\u00e9coute. Laissez Scan to Me ouvert, puis sur l'imprimante choisissez Num\u00e9riser > Ordinateur > \u00ab %@ \u00bb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76d1\u542c\u671f\u95f4\u5c4f\u5e55\u5c06\u4fdd\u6301\u4eae\u8d77\u3002\u8bf7\u4fdd\u6301 Scan to Me \u6253\u5f00\uff0c\u7136\u540e\u5728\u6253\u5370\u673a\u4e0a\u9009\u62e9\u201c\u626b\u63cf\u201d>\u201c\u8ba1\u7b97\u673a\u201d>\u201c%@\u201d\u3002"
          }
        }
      }
    },
    "This printer is already in your list as \"%@\".": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora ya est\u00e1 en tu lista como \u00ab%@\u00bb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette imprimante figure d\u00e9j\u00e0 dans votre liste sous le nom \u00ab %@ \u00bb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6253\u5370\u673a\u5df2\u5728\u5217\u8868\u4e2d\uff0c\u540d\u79f0\u4e3a\u201c%@\u201d\u3002"
          }
        }
      }
    },
    "Tokens: {date} {time} {page}. A shortcut chosen on the printer (Save as Document / Save as Photo) overrides the format.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Variables: {date} {time} {page}. Un acceso directo elegido en la impresora (Guardar como documento / como foto) sustituye al formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetons : {date} {time} {page}. Un raccourci choisi sur l'imprimante (Enregistrer comme document / comme photo) remplace le format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u7528\u53d8\u91cf\uff1a{date} {time} {page}\u3002\u5728\u6253\u5370\u673a\u4e0a\u9009\u62e9\u7684\u5feb\u6377\u65b9\u5f0f\uff08\u5b58\u50a8\u4e3a\u6587\u6863/\u5b58\u50a8\u4e3a\u7167\u7247\uff09\u4f1a\u8986\u76d6\u6b64\u683c\u5f0f\u3002"
          }
        }
      }
    },
    "Trim empty margins": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar m\u00e1rgenes vac\u00edos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rogner les marges vides"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u88c1\u526a\u7a7a\u767d\u8fb9\u8ddd"
          }
        }
      }
    },
    "Trim: a smaller original (receipt, card, photo, half sheet) placed in the corner of the glass is saved at its own size instead of a full page. Full-width pages and the document feeder are never trimmed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorte: un original m\u00e1s peque\u00f1o (tique, tarjeta, foto, media hoja) colocado en la esquina del cristal se guarda a su tama\u00f1o real en lugar de una p\u00e1gina completa. Las p\u00e1ginas de ancho completo y el alimentador de documentos nunca se recortan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rognage : un original plus petit (ticket, carte, photo, demi-page) pos\u00e9 dans le coin de la vitre est enregistr\u00e9 \u00e0 sa taille r\u00e9elle au lieu d'une page enti\u00e8re. Les pages pleine largeur et le chargeur de documents ne sont jamais rogn\u00e9s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u88c1\u526a\uff1a\u653e\u5728\u626b\u63cf\u73bb\u7483\u89d2\u843d\u7684\u8f83\u5c0f\u539f\u4ef6\uff08\u5c0f\u7968\u3001\u5361\u7247\u3001\u7167\u7247\u3001\u534a\u9875\u7eb8\uff09\u5c06\u6309\u5176\u5b9e\u9645\u5c3a\u5bf8\u4fdd\u5b58\uff0c\u800c\u975e\u6574\u9875\u3002\u5168\u5bbd\u9875\u9762\u548c\u81ea\u52a8\u8fdb\u7eb8\u5668\u626b\u63cf\u7684\u9875\u9762\u4e0d\u4f1a\u88ab\u88c1\u526a\u3002"
          }
        }
      }
    },
    "Use the app folder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar la carpeta de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le dossier de l'app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528 App \u6587\u4ef6\u5939"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7248\u672c"
          }
        }
      }
    },
    "access to the chosen folder was denied": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se ha denegado el acceso a la carpeta elegida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l'acc\u00e8s au dossier choisi a \u00e9t\u00e9 refus\u00e9"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbf\u95ee\u6240\u9009\u6587\u4ef6\u5939\u88ab\u62d2\u7edd"
          }
        }
      }
    },
    "may not be supported yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "puede que a\u00fan no sea compatible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "peut-\u00eatre pas encore prise en charge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u80fd\u5c1a\u4e0d\u652f\u6301"
          }
        }
      }
    },
    "moved": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "movido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "d\u00e9plac\u00e9"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u79fb\u52a8"
          }
        }
      }
    },
    "the app's Documents folder could not be found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se encuentra la carpeta Documentos de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le dossier Documents de l'app est introuvable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u4e0d\u5230 App \u7684\u201c\u6587\u7a3f\u201d\u6587\u4ef6\u5939"
          }
        }
      }
    }
  },
  "version": "1.0"
}
