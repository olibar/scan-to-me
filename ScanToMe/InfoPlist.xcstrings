{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me talks to your printer on the local network so it can receive the pages you scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me se comunica con tu impresora en la red local para recibir las p\u00e1ginas que escaneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me communique avec votre imprimante sur le r\u00e9seau local pour recevoir les pages que vous num\u00e9risez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me \u9700\u8981\u901a\u8fc7\u672c\u5730\u7f51\u7edc\u4e0e\u4f60\u7684\u6253\u5370\u673a\u901a\u4fe1\uff0c\u4ee5\u63a5\u6536\u4f60\u626b\u63cf\u7684\u9875\u9762\u3002"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me can add your JPEG scans to the Photos library when you enable that option in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me puede a\u00f1adir tus escaneos JPEG a la fototeca cuando activas esa opci\u00f3n en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to Me peut ajouter vos num\u00e9risations JPEG \u00e0 la phototh\u00e8que lorsque vous activez cette option dans R\u00e9glages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u4f60\u5728\u201c\u8bbe\u7f6e\u201d\u4e2d\u5f00\u542f\u8be5\u9009\u9879\u65f6\uff0cScan to Me \u53ef\u5c06 JPEG \u626b\u63cf\u4ef6\u6dfb\u52a0\u5230\u7167\u7247\u56fe\u5e93\u3002"
          }
        }
      }
    }
  },
  "version": "1.0"
}
